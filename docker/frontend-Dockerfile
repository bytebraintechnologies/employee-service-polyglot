FROM node:18-alpine as build

WORKDIR /app

# Copy package.json and package-lock.json
COPY frontend-app/package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the app
COPY frontend-app/ ./

# Copy Docker-specific files
COPY docker/constants-docker.js ./src/constants/backends.js
COPY docker/apiService-docker.js ./src/services/apiService.js

# Build the app
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built assets from the build stage
COPY --from=build /app/build /usr/share/nginx/html

# Add nginx configuration to handle React routing
COPY frontend-app/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]